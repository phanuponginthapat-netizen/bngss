{
  "manifest_version": 3,
  "name": "โรงเรียนของฉัน — Safe Browser",
  "version": "1.7.0",
  "description": "เบราว์เซอร์ปลอดภัยสำหรับนักเรียน เชื่อมกับระบบโรงเรียน บันทึกการใช้งาน กรองโฆษณา/เว็บพนัน/สื่อลามก ด้วยโดเมนและคำต้องห้าม (keyword filter) จัดการ Wi-Fi ในโหมด kiosk และรัน Monitor Agent อัตโนมัติ",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "activeTab",
    "scripting",
    "webNavigation",
    "declarativeNetRequest",
    "downloads",
    "alarms",
    "notifications",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safe Browser",
    "default_icon": "icon.png"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ads",
        "enabled": true,
        "path": "rules/ads.json"
      },
      {
        "id": "gambling",
        "enabled": true,
        "path": "rules/gambling.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://bngss.lovable.app/*",
        "https://*.lovable.app/*",
        "https://bngss.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "session-sync.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.youtube-nocookie.com/*"
      ],
      "js": [
        "yt-ads.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://bngss.lovable.app/*",
        "https://*.lovable.app/*",
        "https://bngss.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "toolbar.js"
      ],
      "css": [
        "toolbar.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "https://bngss.lovable.app/*",
        "https://*.lovable.app/*",
        "https://bngss.vercel.app/*",
        "https://*.vercel.app/*",
        "http://localhost/*"
      ],
      "js": [
        "keywords.js",
        "keyword-guard.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html",
        "wifi.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}